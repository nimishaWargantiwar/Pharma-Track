# ==============================================================================
# PharmaTrack MES & eBR Frontend - Environment Variables Example
# ==============================================================================
# Vite exposes variables prefixed with VITE_ to browser builds.
# Do NOT put secrets or private keys in frontend environment variables.
# For local overrides, create a gitignored .env.local file in frontend/.
# ==============================================================================

# Base URL for the Spring Boot REST API (MUST include the /api suffix, no trailing slash)
# Local development example:
VITE_API_BASE_URL=http://localhost:8080/api

# Vercel / Production example (configure in Vercel Project Settings -> Environment Variables):
# VITE_API_BASE_URL=https://<REPLACE_WITH_BACKEND_DOMAIN>/api

