# ==============================================================================
# PharmaTrack MES & eBR Backend - Environment Variables Example
# ==============================================================================
# Copy values into your host environment (Render, Docker, shell export) or a
# gitignored local file (e.g., backend/config/application-local.properties).
# NEVER commit real passwords, signing keys, or production credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Spring Profile & Server Listener
# ------------------------------------------------------------------------------
# Use "local" for local workstation development or "prod" for deployed servers.
SPRING_PROFILES_ACTIVE=local

# HTTP server port (Render injects PORT dynamically in production deployments).
PORT=8080

# ------------------------------------------------------------------------------
# MySQL 8.0+ Database Connection (Option A: Host/Port/Name OR Option B: DB_URL)
# ------------------------------------------------------------------------------
# Option A: Discrete connection parameters (used when DB_URL is unset or empty)
DB_HOST=<REPLACE_WITH_DB_HOST>
DB_PORT=3306
DB_NAME=pharmatrack_db
DB_USERNAME=<REPLACE_WITH_DB_USERNAME>
DB_PASSWORD=<REPLACE_WITH_DB_PASSWORD>

# Database TLS / SSL configuration for Managed MySQL (e.g., Aiven, RDS, Cloud SQL):
# Recommended in production: REQUIRED, VERIFY_CA, or VERIFY_IDENTITY (PREFERRED also allowed).
# Production rejects useSSL=false and sslMode=DISABLED.
DB_SSL_MODE=REQUIRED
# Optional JDBC truststore settings when using sslMode=VERIFY_CA / VERIFY_IDENTITY:
# DB_SSL_TRUSTSTORE_URL=file:/path/to/truststore.jks
# DB_SSL_TRUSTSTORE_PASSWORD=<REPLACE_WITH_TRUSTSTORE_PASSWORD>

# Option B: Full JDBC URL override (takes precedence over DB_HOST / DB_PORT / DB_NAME when set):
# Production managed MySQL (TLS required, serverTimezone=UTC auto-appended if omitted):
# DB_URL=jdbc:mysql://<REPLACE_WITH_DB_HOST>:3306/<REPLACE_WITH_DB_NAME>?sslMode=REQUIRED&serverTimezone=UTC
# Local dev example (when running with SPRING_PROFILES_ACTIVE=local):
# DB_URL=jdbc:mysql://localhost:3306/pharmatrack_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Optional HikariCP production connection pool tuning (defaults shown):
# DB_POOL_MAX_SIZE=10
# DB_POOL_MIN_IDLE=2

# ------------------------------------------------------------------------------
# JWT Authentication (HS256 - Minimum 256 bits / 32 bytes required)
# ------------------------------------------------------------------------------
# Generate locally with: openssl rand -base64 32
# Prefix with "base64:" if supplying a Base64-encoded binary key, or provide >= 32 UTF-8 chars.
JWT_SECRET=base64:<REPLACE_WITH_BASE64_256_BIT_SECRET>
JWT_EXPIRATION_MS=3600000

# ------------------------------------------------------------------------------
# CORS Configuration (Comma-separated exact origins; wildcard '*' forbidden)
# ------------------------------------------------------------------------------
# Local example: http://localhost:5173,http://127.0.0.1:5173
# Production example: https://<your-frontend-app>.vercel.app
CORS_ALLOWED_ORIGINS=<REPLACE_WITH_CORS_ALLOWED_ORIGINS>

# ------------------------------------------------------------------------------
# Initial Administrator Bootstrap (Non-local profiles fail closed if no ADMIN exists)
# ------------------------------------------------------------------------------
# Password policy: >= 8 chars (recommend >= 14+ in prod), at least 1 letter and 1 digit, max 72 UTF-8 bytes.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=<REPLACE_WITH_ADMIN_USERNAME>
BOOTSTRAP_ADMIN_PASSWORD=<REPLACE_WITH_STRONG_ADMIN_PASSWORD>
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator

# ------------------------------------------------------------------------------
# Optional Local Demo Users (ONLY active when SPRING_PROFILES_ACTIVE=local)
# ------------------------------------------------------------------------------
# Keep LOCAL_DEMO_USERS_ENABLED=false in staging and production environments.
LOCAL_DEMO_USERS_ENABLED=false
# PHARMATRACK_DEMO_PASSWORD=<REPLACE_WITH_LOCAL_DEMO_PASSWORD_ONLY_IF_ENABLED>
